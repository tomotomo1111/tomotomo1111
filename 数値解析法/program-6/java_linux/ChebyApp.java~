//
// 【チェビシェフ近似クラス ChebyApp】
//
// 同一ディレクトリ内の Java プログラムからは，オブジェクトを生成することで
// 利用できます．クラス内メソッドの仕様については，コメントを参照して下さい．
//
public class ChebyApp{
  int n;			// 補間多項式の次数
  double [] x;	// 分点
  double [] c;	// 係数
  boolean coef_flag;	// 係数フラグ (計算済み -> true, 未計算 -> false)

  //
  // コンストラクタ
  //  【入力値】
  //    np = 補間多項式の次数
  //
  // * 分点の生成，係数格納配列の生成，および係数フラグの初期化を行います．
  //
  ChebyApp(int np){
  int k;

  // 補間多項式の次数の格納
  n = np;

  // 分点の生成
  x = new double[n+1];
  for (k = 0 ; k <= n ; k++){
      x[k] = Math.cos(Math.PI * (k + 0.5) / (n + 1.));
  }

  // 係数配列の生成
  c = new double[n+1];

  // 係数フラグの初期化
  coef_flag = false;
  }

  //
  //  チェビシェフ多項式計算メソッド
  //  【入力】
  //   i = 多項式次数
  //   x = 多項式の値を求める点
  //
  //  【返却値】
  //   x における i 次チェビシェフ多項式の値
  //
  //  * x における i 次チェビシェフ多項式 T_i (x) の値を求めます．
  //
  double ChebyPoly(int i, double x){
  // [演習] チェビシェフ多項式計算関数を完成させてください (p.28の漸化式＋再帰関数で定義すると簡単．nをiに読み替えてください)
    double a = -1.;
    switch (i) {
      case 0 :
        a = 1.;
        break;
      case 1 :
        a = x;
        break;
      default :
        a = 2. * x * ChebyPoly(i - 1, x) - ChebyPoly(i - 2, x);
    }
    return a;
  }

  //
  //  チェビシェフ近似係数計算メソッド
  //  【入力】
  //   f[] = 分点における関数値
  //
  //  * 与えられた関数に対するチェビシェフ係数を求めます．
  //
  void ChebyCoef(double[] f){
    int i, k;

    // 分点数
    int np = f.length;

    if (n != np-1){
        throw new IllegalArgumentException("分点数とデータ数が合っていません．");
    }
    else{
      // [演習] チェビシェフ近似の係数 c_i (p.32) を計算するメソッドを完成させてください
      for (k = 0; k < np; k++) {
        c[0] += f[k];
      }
        c[0] *= 1. / (np + 1.);
      for (i = 1; i < np; i++) {
        for (k = 0; k < np; k++) {
          x[k] = Math.cos(Math.PI * (k + 0.5) / (np + 1.));
          c[i] += f[k] * ChebyPoly(i, x[k]);
        } 
          c[i] *= 2. / (np + 1.);
      }
      // 係数フラグの更新
      coef_flag = true;
    }
  }

  //
  // チェビシェフ近似計算メソッド
  //  【入力】
  //   xval = 補間値を計算する点
  //
  //  【返却値】
  //   xval における補間値
  //
  //  * 与えられた点におけるチェビシェフ近似による補間値を求めます．
  //    このメソッドを使用する前に，ChebyshevCoef メソッドにより
  //    係数を求めておく必要があります．
  //
  double ChebyCalc(double xval){
    double rval = 0.0;

    if (coef_flag == false){
        System.err.println("係数を計算してから本メソッドを使用して下さい．");
    }
    else{
        for (int i = 0 ; i <= n ; i++) rval += c[i] * ChebyPoly(i, xval);
    }
  
    return(rval);
  }

  //
  //  分点表示メソッド
  //  【返却値】
  //   分点 (1次元配列)
  //
  //  * 保存されている分点配列を返却します．
  //
  void showpoints(double[] xp){
    int i;
  
    if (xp.length != n+1){
        throw new IllegalArgumentException("分点数と配列サイズが合っていません．");
    }
    else{
        for (i = 0 ; i <=n ; i++) xp[i] = x[i];
    }
  }
}
