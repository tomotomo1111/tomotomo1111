// pgm ファイルから画像データの読込とファイルへの書き出し
// コンパイル後の実行コマンドは　a.out であれば、
// ./a.out <inputimage>.pgm  <outputimage>.pgm 
// で実行すると, inputimage.pgm を読込み、処理結果をoutputimage.pgm に出力する

#include <stdio.h>
#include <string.h>

int main(int argc, char *argv[ ]){
  FILE *fpi=NULL;  // 入力画像
  FILE *fpo=NULL;  // 出力画像

  char buf[258];
  int width, height; // 画像の横長と縦長
  int maxvalue;  // 画像の最大輝度値
  int i, x, y;

  //ファイル argv[1]  から画像データを読込む

  if(argc != 3){
    printf(" Please use the following command format! \n\n");
    printf("      %s [inpuimage].pgm [outputimage].pgm  \n\n", argv[0]);
    return -1; 
  }

  fpi=fopen(argv[1], "r");

  if(fpi==NULL)
    printf("Reading file open error ! %s\n", argv[1]);
   
  do  {
       fgets(buf, 256, fpi);
  } while(buf[0] == '#');  // skip over comments

  if(buf[0] != 'P' || buf[1] != '2') {
    fclose(fpi);
    printf(" \n The input image is not pgm format! \n\n");
    return -1;
  }   

  do   {
       fgets(buf , 256 , fpi) ;
   } while(buf [0 ] == '#') ;  // skip over comments

  sscanf(buf , "%d %d" , &width , &height) ; // 画像サイズを読み込む
  fscanf(fpi , "%d" , &maxvalue) ; //最大の輝度値を読み込み

  int img[height][width];

  for(y=0; y<height; y++) {  //画像データを読込む
    for(x=0; x<width; x++) {
      fscanf(fpi, "%d", &img[y][x]);
    }
  }   
  //    画像中(x,y)の位置にある画素をimg[y][x]で参照できる。

  fclose(fpi); 

  //画像データに対する処理
  //各要素の値を +80
  //ただし、画素値が maxvalue より大きい場合、maxvalue に変更
 
 for(y=0; y<height; y++) {
    for(x=0; x<width; x++) {
      img[y][x] = img[y][x] + 80;
      if(img[y][x] > maxvalue)
      	img[y][x] = maxvalue; 
    }
 }

 //画像データをファイル arg[2] に出力する

  fpo=fopen(argv[2], "w");

  if(fpo==NULL)
    printf("Reading file open error ! %s\n", argv[2]); 

  fprintf(fpo, "P2\n") ;
  fprintf(fpo, "# %s\n", argv[2]);
  fprintf(fpo, "%d %d", width, height);
  fprintf(fpo, " \n");
  fprintf(fpo, "%d", maxvalue);
  fprintf(fpo, " \n") ;

  int count=0; 

  for(y=0; y<height; y++) {
    for(x=0; x<width; x++) {
      fprintf(fpo, "%3d ", img[y][x]);
      count++;
      if(count%18 == 0){
	fprintf(fpo, "\n");  //1行18個画素
      }
    }
  }
  fclose(fpo) ;  // 出力画像をクローズする
}
