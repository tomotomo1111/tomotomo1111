        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"v0", " ", "+", " ", 
            RowBox[{"gamma", " ", "u0"}]}], ")"}], "/", "omega1"}], " ", 
         RowBox[{"Sin", "[", 
          RowBox[{"omega1", " ", "t"}], "]"}]}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
