%%BeginDocument: ./figs/right-hand.eps
%!PS-Adobe-3.0 EPSF-3.0
%%Creator: (ImageMagick)
%%Title: (./figs/right-hand.eps)
%%CreationDate: (2022-06-15T00:30:32+00:00)
%%BoundingBox: -0 -0 142 164
%%HiResBoundingBox: 0 0 142.459 164
%%DocumentData: Clean7Bit
%%LanguageLevel: 1
%%Pages: 1
