        RowBox[{"-", "gamma"}], " ", "t"}], "]"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"v0", " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"omega1", " ", "t"}], "]"}]}], "-", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"gamma", " ", "v0"}], " ", "+", " ", 
